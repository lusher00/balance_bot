# Safe to leave enabled.
#
# This used to be diagnostic-only: at 1 Hz with a per-second fsync it cost ~10%
# of the BeagleBone's single core and pushed system time to 65%, starving ssh
# and the telemetry bridge. Three things changed, none of which give up
# coverage -- see the header of tools/bbot_watch.py:
#
#   * PIDs are cached instead of rescanning all of /proc twice a second
#     (measured ~62x cheaper per sample)
#   * idle sampling is 5 s, dropping to 1 s automatically the moment anything
#     looks wrong, and holding there for a minute
#   * fsync is once a minute when idle, every sample while alerting
#
# So it now spends effort only when there is something to record. To go back to
# the old always-on-full-detail behaviour while actively hunting a lockup:
#
#   sudo systemctl stop bbot-watch
#   sudo ./tools/bbot_watch.py --paranoid     (then Ctrl-C and start the unit again)
#
# After a lockup:  ./tools/bbot_watch.py --postmortem
#
[Unit]
Description=Balance Bot system recorder (lockup / SSH-drop diagnosis)
# Deliberately NOT tied to balance_bot.service. If the board wedges while
# balance_bot is stopped, that is itself a finding — the recorder has to be
# running whenever the board is.
DefaultDependencies=yes
After=local-fs.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /home/debian/balance_bot/tools/bbot_watch.py

# Never let the recorder be the thing that starves the control loop.
Nice=10
IOSchedulingClass=idle
CPUWeight=10

# Adaptive: cheap when idle, full resolution when something is wrong.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
