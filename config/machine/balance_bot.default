# Example for /etc/default/balance_bot
#
#   sudo cp systemd/balance_bot.default.example /etc/default/balance_bot
#
# This file is NOT versioned once installed — it holds the settings that are
# specific to one physical robot. Edit it on the bot, then:
#
#   sudo systemctl restart balance_bot
#
# No daemon-reload needed: EnvironmentFile is re-read on each start.

# Arguments passed to /usr/local/bin/balance_bot.
#
#   -q                quiet: log at WARN. Under systemd there is no controlling
#                     terminal, so the ncurses display cannot attach anyway —
#                     display_thread() checks newterm() for NULL and exits.
#                     Do not bother with -d here; it only adds journal noise.
#   -i sbus           input source: sbus | xbox | ext | none
#   -u /dev/ttyS5     SBUS receiver UART. REQUIRED — the compiled default is
#                     SBUS_UART_DEFAULT "/dev/ttyO4" (legacy OMAP name), which
#                     is not this board's device. Omit it and the RC tab in the
#                     dashboard shows NO LINK.
#   -m /dev/ttyS1     RoboClaw motor controller UART
#   -B 460800         RoboClaw baud (must match the RoboClaw's own setting)
#
# Other useful flags: -p <config path> (default robot.conf), -b/-t for the
# ext-input UART.

BOT_ARGS="-q -i sbus -u /dev/ttyS5 -m /dev/ttyS1 -B 460800"
