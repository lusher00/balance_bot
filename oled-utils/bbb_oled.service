[Unit]
Description=bbot OLED Status Display
Documentation=https://github.com/rlush/balance_bot
# network.target, not network-online.target. The display shows "no ip" quite
# happily and there is no reason to hold up boot waiting for DHCP just to draw
# a status screen. network-online.target can add tens of seconds.
After=network.target
# The panel is useless without its bus. If i2c-1 has not appeared, fail fast
# with a clear reason instead of respawning every 5s forever.
ConditionPathExists=/dev/i2c-1
# Don't respawn forever against a hard fault; give up and stay failed so it is
# visible in `systemctl --failed`. These are [Unit] keys, not [Service].
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=debian
# Whichever group owns /dev/i2c-*, the service must be in it or it dies on a
# permission error that reads like a missing device.
#
# BOTH names are listed on purpose. Most distributions ship /dev/i2c-* as
# root:i2c, but this BeagleBone image ships it as root:gpio -- and a unit that
# granted only 'i2c' started fine, then exited 1 on the first bus access, which
# systemd reported as a restart loop with no hint of a permission problem.
# Listing a group that does not exist on a given image is harmless.
#
# Note that `usermod -aG` on the user is NOT sufficient: systemd starts the
# service with exactly the groups named here.
SupplementaryGroups=i2c gpio
# -u so print/logging reach the journal immediately instead of sitting in a
# pipe buffer until the process exits.
ExecStart=/usr/bin/python3 -u /usr/local/bin/bbb_oled.py $OLED_ARGS
# Options live here so they can be changed without editing the unit.
EnvironmentFile=-/etc/default/bbb_oled
Restart=always
RestartSec=5

# /run/bbb_oled, created on start and removed on stop. Needed because
# ProtectSystem=strict below makes /run read-only, and the status file has to
# go somewhere the dashboard can read it. Removal on stop is the point as much
# as creation: a stopped service must not leave a stale "ok" behind.
RuntimeDirectory=bbb_oled

# Modest hardening. This process needs one character device and one directory
# in /run; it has no business anywhere else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
DeviceAllow=char-i2c rw

[Install]
WantedBy=multi-user.target
